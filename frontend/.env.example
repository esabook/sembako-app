# Deployment mode — dipakai saat build (bun run build), wajib rebuild setelah ganti nilai.
# 'offline' : LAN / Raspberry Pi — cache agresif, cocok untuk jaringan toko yang lambat
# 'online'  : cloud VPS / internet — cache minimal, data lebih fresh
PUBLIC_DEPLOYMENT_MODE=offline

# Base URL API. Kosong = gunakan /api (relative, lewat Nginx reverse proxy).
# Untuk cloud VPS tanpa Nginx: isi dengan full URL, misal: https://api.namadomain.com
PUBLIC_API_URL=

# Web analytics marketing (Umami) — HANYA aktif saat PUBLIC_DEPLOYMENT_MODE=online.
# Kosongkan keduanya untuk menonaktifkan (build LAN/offline otomatis tidak memuat script).
# PUBLIC_UMAMI_SRC : URL script Umami, mis. https://analytics.domain.com/script.js
# PUBLIC_UMAMI_ID  : Website ID dari dashboard Umami
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_ID=
