		"svelte-check": "^4.4.6",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vite-plugin-mkcert": "^2.0.0"
	},
	"dependencies": {
		"@types/papaparse": "^5.5.2",
		"barcode-detector": "^3.1.3",
		"clsx": "^2.1.1",
		"jsbarcode": "^3.12.3",
		"papaparse": "^5.5.3",
		"qrcode": "^1.5.4",
		"tailwind-merge": "^3.6.0",
		"tinykeys": "^4.0.0"
	}
}
