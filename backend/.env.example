# Wajib diganti di production — gunakan string random 32+ karakter
JWT_SECRET=dev-secret-change-in-production

# Durasi sesi login (jam). Default 12 (setengah hari). Untuk kasir shift 24 jam, set ke 24.
JWT_EXPIRY_HOURS=12

# Port HTTP backend (default 3000)
PORT=3000

# CORS origin frontend. Untuk multi-origin, pisahkan dengan koma:
#   FRONTEND_URL=http://192.168.1.10:5173,https://kasir.namadomain.com
FRONTEND_URL=http://localhost:5173

# Gating langganan SaaS — set ke 1 HANYA di mode cloud/online untuk mengunci
# operasi mutasi saat trial habis/suspended. Kosong/0 = mode LAN/offline (no-op).
# SAAS_GATING=1

# Database — pilih salah satu, uncomment yang dipakai
#
# SQLite lokal (default, offline/LAN — Raspberry Pi, dev)
DATABASE_URL=file:./data.db
#
# PostgreSQL — Supabase
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# PostgreSQL — self-hosted / VPS
# DATABASE_URL=postgresql://user:password@localhost:5432/stokasir
#
# Turso (libSQL remote, hosted)
# DATABASE_URL=libsql://[db-name]-[org].turso.io
# TURSO_AUTH_TOKEN=your-token-here
#
# libSQL self-hosted (sqld di VPS sendiri)
# DATABASE_URL=https://[ip-atau-domain]:8080
# TURSO_AUTH_TOKEN=your-token-here
#
# MySQL / PlanetScale
# DATABASE_URL=mysql://user:password@localhost:3306/stokasir

# ── File Storage ──────────────────────────────────────────────────────────────
#
# STORAGE_DRIVER=local   (default) — simpan ke UPLOAD_DIR di disk, cocok untuk Pi/VPS
# STORAGE_DRIVER=s3      — upload ke S3-compatible (Cloudflare R2, AWS S3, MinIO, Tigris)
#
STORAGE_DRIVER=local

# Direktori upload file gambar — hanya dipakai jika STORAGE_DRIVER=local
UPLOAD_DIR=./uploads

# S3 / R2 / MinIO — hanya dipakai jika STORAGE_DRIVER=s3
#
# Cloudflare R2:
#   S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_PUBLIC_URL=https://pub-<hash>.r2.dev   (atau custom domain R2)
#
# AWS S3:
#   S3_ENDPOINT=                               (kosongkan untuk AWS default endpoint)
#   S3_REGION=ap-southeast-1
#   S3_PUBLIC_URL=https://<bucket>.s3.<region>.amazonaws.com
#
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key
# S3_BUCKET=stokasir-uploads
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://cdn.example.com
