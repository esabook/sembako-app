# Wajib diganti di production — gunakan string random 32+ karakter
JWT_SECRET=dev-secret-change-in-production

# Durasi sesi login (jam). Default 12 (setengah hari). Untuk kasir shift 24 jam, set ke 24.
JWT_EXPIRY_HOURS=12

# Port HTTP backend (default 3000)
PORT=3000

# CORS origin frontend. Untuk multi-origin, pisahkan dengan koma:
#   FRONTEND_URL=http://192.168.1.10:5173,https://kasir.namadomain.com
FRONTEND_URL=http://localhost:5173

# Database — pilih salah satu, uncomment yang dipakai
#
# SQLite lokal (default, offline/LAN — Raspberry Pi, dev)
DATABASE_URL=file:./data.db
#
# PostgreSQL — Supabase
# DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# PostgreSQL — self-hosted / VPS
# DATABASE_URL=postgresql://user:password@localhost:5432/stokasir
#
# Turso (libSQL remote, hosted)
# DATABASE_URL=libsql://[db-name]-[org].turso.io
# TURSO_AUTH_TOKEN=your-token-here
#
# libSQL self-hosted (sqld di VPS sendiri)
# DATABASE_URL=https://[ip-atau-domain]:8080
# TURSO_AUTH_TOKEN=your-token-here
#
# MySQL / PlanetScale
# DATABASE_URL=mysql://user:password@localhost:3306/stokasir

# Direktori upload file gambar (relatif terhadap direktori backend/)
UPLOAD_DIR=./uploads
